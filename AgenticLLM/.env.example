# Copy to .env and adjust as needed:
#   cp .env.example .env

# ── Paths ──────────────────────────────────────────────────────────────────────
LLAMA_CPP_DIR=/home/pathipatisunilkumar/llama-cpp-turboquant
MODELS_DIR=/home/pathipatisunilkumar/models

# ── Model selection (change these to switch models) ────────────────────────────
MODEL_PATH=/home/pathipatisunilkumar/models/Qwen3.6-35B-A3B-UD-Q8_K_XL.gguf
MODEL_ALIAS=qwen3.6-35b

# Optional separate draft model for --spec-type draft-dflash / draft-simple
# LLAMA_DRAFT_MODEL=/home/pathipatisunilkumar/models/dflash-Qwen3.6-27B-Q8_0.gguf

# ── Shared llama-server (OpenAI-compatible :8080/v1) ──────────────────────────
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
SLOT_SAVE_PATH=/home/pathipatisunilkumar/.testgen/slots

# ── llama-server tuning (adjust per model / hardware) ──────────────────────────
LLAMA_CTX_SIZE=40000
LLAMA_N_PREDICT=24000
LLAMA_THREADS=12
LLAMA_NGL=999
LLAMA_FIT=on
LLAMA_FLASH_ATTN=on
# TurboQuant KV cache (requires llama-cpp-turboquant + flash-attn). turbo2|turbo3|turbo4|q8_0|f16
LLAMA_CACHE_TYPE_K=turbo3
LLAMA_CACHE_TYPE_V=turbo3
# mmap | none | dio  (avoid mlock — pins the whole GGUF in resident RAM)
LLAMA_LOAD_MODE=mmap
# Partial-prefix KV reuse (tokens). 0 disables.
LLAMA_CACHE_REUSE=256

# Optional patched Jinja chat template for Qwen3.x (mid-conversation system messages).
# Extract from a running server: curl -s http://127.0.0.1:8080/props | jq -r '.chat_template' > templates/qwen-claude.jinja
# LLAMA_CHAT_TEMPLATE_FILE=templates/qwen-claude.jinja

# Shared HF sampler knobs (top_p/top_k/…). Per-phase temperature +
# presence_penalty are set by UnitTest_gen ADK agents via the openai SDK.
LLAMA_TEMP=0.7
LLAMA_TOP_P=0.8
LLAMA_TOP_K=20
LLAMA_MIN_P=0.0
LLAMA_REPEAT_PENALTY=1.0
LLAMA_SEED=42

# Server reasoning is controlled per request by the ADK OpenAI adapter. Set the
# TESTGEN_*_ENABLE_THINKING and TESTGEN_*_THINKING_BUDGET variables in the shell
# or PipelineConfig; the same request parameters are used for llama.cpp and vLLM.
LLAMA_REASONING=off
LLAMA_REASONING_FORMAT=deepseek

# Speculative decoding for tool agents: MTP + ngram-cache (MoE sweet spot n_max=2).
# Rollback: LLAMA_SPEC_TYPE=none  |  MTP only: LLAMA_SPEC_TYPE=draft-mtp
LLAMA_SPEC_TYPE=draft-mtp,ngram-cache
LLAMA_SPEC_DRAFT_N_MAX=2
LLAMA_SPEC_DRAFT_P_MIN=0.0
LLAMA_LOOKUP_CACHE_DYNAMIC=/home/pathipatisunilkumar/git/journey_log/conx-journey-log-app/UnitTest_gen/AgenticLLM/logs/ngram-cache-dynamic.bin
# LLAMA_LOOKUP_CACHE_STATIC=

# ── Optional Ollama backend (TESTGEN_PROMPT_CACHE=ollama) ─────────────────────
# Keep one model resident; serialise requests so KV prefix reuse works.
# OLLAMA_KEEP_ALIVE=24h
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_MAX_LOADED_MODELS=1
# OLLAMA_CONTEXT_LENGTH=42000
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
# Per-request options: {"use_mmap": true, "use_mlock": false}

# ── Model alias (openai chat.completions model=) ─────────────────────────────
# Used by ADK agents through the OpenAI SDK against llama :8080/v1 or remote vLLM.
ANTHROPIC_MODEL=qwen3.6-35b
MODEL_ALIAS=qwen3.6-35b

# ── Remote vLLM (optional; shell / UnitTest_gen env) ──────────────────────────
#   export TESTGEN_LLM_BACKEND=vllm
#   export TESTGEN_VLLM_BASE_URL=https://your-tunnel.example.com   # with or without /v1
#   export TESTGEN_VLLM_API_KEY=your-cloudflare-or-vllm-key
#   export TESTGEN_AGENT_MODEL=served-model-name
# CLI equivalent:
#   --llm-backend vllm --vllm-base-url URL --vllm-api-key KEY --agent-model NAME
# ADK agents stream Chat Completions by default (reasoning/content/tools live on TTY).
# Disable with TESTGEN_AGENT_STREAM=0 or --no-stream.
