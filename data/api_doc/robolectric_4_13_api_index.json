  "generator_script": {
    "purpose": "Generate guaranteed exhaustive API index by scraping Javadoc HTML locally when network access is available.",
    "python": "import json, re, requests\\nfrom bs4 import BeautifulSoup\\nBASE='https://robolectric.org/javadoc/4.13/'\\nhtml=requests.get(BASE+'allclasses-index.html', timeout=60).text\\nsoup=BeautifulSoup(html,'html.parser')\\nclasses=[]\\nfor a in soup.select('main a[href], .type-summary a[href], a[href$=\\\".html\\\"]'):\\n    href=a.get('href','')\\n    name=a.get_text(' ', strip=True)\\n    if href.endswith('.html') and not href.startswith('http') and name and '/' in href:\\n        classes.append((name, href))\\nseen=set(); out=[]\\nfor name, href in classes:\\n    if href in seen: continue\\n    seen.add(href)\\n    page=requests.get(BASE+href, timeout=60).text\\n    psoup=BeautifulSoup(page,'html.parser')\\n    title=psoup.select_one('h1')\\n    fqcn='.'.join(href[:-5].split('/'))\\n    item={'class': fqcn, 'simple_name': name, 'url': BASE+href, 'methods': [], 'constructors': [], 'fields': [], 'enum_constants': []}\\n    for table_kind, key in [('method-summary','methods'),('constructor-summary','constructors'),('field-summary','fields'),('constant-summary','enum_constants')]:\\n        for sec in psoup.select('[id*=\\\"'+table_kind+'\\\"], section.'+table_kind):\\n            for code in sec.select('code'):\\n                txt=' '.join(code.get_text(' ', strip=True).split())\\n                if txt and txt not in item[key]: item[key].append(txt)\\n    # fallback for JDK17 javadocs\\n    for h in psoup.find_all(['h2','h3']):\\n        label=h.get_text(' ', strip=True).lower()\\n        key=None\\n        if 'method summary' in label: key='methods'\\n        elif 'constructor summary' in label: key='constructors'\\n        elif 'field summary' in label: key='fields'\\n        if key:\\n            nxt=h.find_next(['div','table'])\\n            if nxt:\\n                for code in nxt.select('code'):\\n                    txt=' '.join(code.get_text(' ', strip=True).split())\\n                    if txt and txt not in item[key]: item[key].append(txt)\\n    out.append(item)\\njson.dump({'library':'Robolectric','version':'4.13','source':BASE,'classes':out}, open('robolectric_4_13_full_api_index.json','w'), indent=2)\\nprint('classes', len(out))\\n"
  }
